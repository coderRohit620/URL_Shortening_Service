{
	"info": {
		"_postman_id": "url-shortener-collection-v1",
		"name": "URL Shortening Service",
		"description": "Complete API collection for the URL Shortening Service backend.\n\n**How to use:**\n1. Import this file into Postman\n2. Select the **URL Shortener - Local** environment\n3. Run requests in order: Register → Login (token auto-saves) → rest of the APIs",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "🟢 Health Check",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/",
					"host": ["{{baseUrl}}"],
					"path": [""]
				},
				"description": "Verify the server is running."
			}
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Rohit Ravi\",\n    \"email\": \"rohit@example.com\",\n    \"password\": \"rohit123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "register"]
						},
						"description": "Create a new user account. Returns accessToken + user object."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.data && json.data.accessToken) {",
									"    pm.collectionVariables.set('accessToken', json.data.accessToken);",
									"    pm.collectionVariables.set('userId', json.data.user._id);",
									"    console.log('✅ accessToken saved automatically');",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"rohit@example.com\",\n    \"password\": \"rohit123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "login"]
						},
						"description": "Login with email + password. **accessToken is automatically saved** to collection variables via the test script."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.data && json.data.accessToken) {",
									"    pm.collectionVariables.set('accessToken', json.data.accessToken);",
									"    pm.collectionVariables.set('userId', json.data.user._id);",
									"    console.log('✅ accessToken saved automatically');",
									"} else {",
									"    console.log('❌ Login failed:', JSON.stringify(json));",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Get Current User (me)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/me",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "me"]
						},
						"description": "Returns the currently logged-in user's details. Requires Authorization header."
					}
				},
				{
					"name": "Logout",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/logout",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "auth", "logout"]
						},
						"description": "Clears the refresh token from DB and cookies. Run this last."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.collectionVariables.unset('accessToken');",
									"console.log('✅ accessToken cleared from collection variables');"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "URL",
			"item": [
				{
					"name": "Shorten URL",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"fullUrl\": \"https://www.google.com/search?q=url+shortener+nodejs+tutorial\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/url/shorten",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "url", "shorten"]
						},
						"description": "Creates a shortened URL. **short_url and _id are auto-saved** to collection variables."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const json = pm.response.json();",
									"if (json.data && json.data._id) {",
									"    pm.collectionVariables.set('urlId', json.data._id);",
									"    pm.collectionVariables.set('shortCode', json.data.short_url);",
									"    console.log('✅ urlId:', json.data._id);",
									"    console.log('✅ shortCode:', json.data.short_url);",
									"    console.log('🔗 Test redirect: http://localhost:8000/' + json.data.short_url);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Get My URLs",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/url/my-urls",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "url", "my-urls"]
						},
						"description": "Returns all URLs created by the logged-in user, sorted newest first."
					}
				},
				{
					"name": "Delete URL",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{accessToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/api/v1/url/{{urlId}}",
							"host": ["{{baseUrl}}"],
							"path": ["api", "v1", "url", "{{urlId}}"]
						},
						"description": "Deletes the URL by ID. Only works if the URL belongs to the logged-in user. Uses the urlId auto-saved by the Shorten URL request."
					}
				},
				{
					"name": "Public Redirect (browser)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/{{shortCode}}",
							"host": ["{{baseUrl}}"],
							"path": ["{{shortCode}}"]
						},
						"description": "Public redirect. Uses the shortCode auto-saved by the Shorten URL request. In Postman, disable 'Follow Redirects' in Settings to see the 302 response. In a browser, it will redirect automatically."
					}
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8000",
			"type": "string"
		},
		{
			"key": "accessToken",
			"value": "",
			"type": "string"
		},
		{
			"key": "urlId",
			"value": "",
			"type": "string"
		},
		{
			"key": "shortCode",
			"value": "",
			"type": "string"
		},
		{
			"key": "userId",
			"value": "",
			"type": "string"
		}
	]
}
